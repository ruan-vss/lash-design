# ==========================================================
# CONFIGURAÇÃO DO SERVIDOR
# ==========================================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
# false em acesso direto; use 1 quando houver exatamente um proxy reverso confiável
TRUST_PROXY=false

# ==========================================================
# BANCO DE DADOS (PostgreSQL)
# ==========================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lash_studio_db
DB_SSL=false

# ==========================================================
# SEGREDOS CRIPTOGRÁFICOS (OBRIGATÓRIOS)
# Gere cada segredo com: openssl rand -hex 64
# NUNCA use o mesmo valor para JWT_SECRET e CLIENT_LOOKUP_SECRET
# ==========================================================
JWT_SECRET=
JWT_EXPIRES_IN=15m
CLIENT_LOOKUP_SECRET=

# ==========================================================
# SEED INICIAL (Obrigatório caso execute seed em production)
# ==========================================================
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Recuperação de senha por e-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_URL=http://localhost:5173/admin/redefinir-senha

# ==========================================================
# WHATSAPP CLOUD API (META)
# ==========================================================
# Crie um app no Meta for Developers / WhatsApp e informe o Phone Number ID e token.
WHATSAPP_GRAPH_API_BASE=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Token escolhido por você para a verificação GET do webhook da Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret do aplicativo Meta; habilita validação HMAC x-hub-signature-256
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_COUNTRY_CODE=55
WHATSAPP_REQUEST_TIMEOUT_MS=10000
