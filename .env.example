# Copie para .env e preencha. NUNCA versione o .env.
# Gere segredos com:  openssl rand -hex 32   (senha do banco)  |  openssl rand -hex 64  (JWTs)

DOMAIN=agenda.seudominio.com.br        # em teste local: localhost

POSTGRES_PASSWORD=                      # só hex/alfanumérico (vai dentro de uma URL)
JWT_SECRET=
CLIENT_LOOKUP_SECRET=                   # DIFERENTE do JWT_SECRET

# Usados só no primeiro seed (docker compose run --rm api node src/database/seed.js)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=                    # mín. 12 caracteres; será exigida a troca no 1º login

# Opcionais
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp Cloud API (se usar, WHATSAPP_APP_SECRET é OBRIGATÓRIO em produção)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
